{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "people"
  ],
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
         "alt": {
            "type": "string"
          },
          "titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affiliations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "homepage": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
	  "role": {
	    "type": "string",
	    "enum": [
	      "alumni",
	      "collaborators",
	      "faculty",
	      "postdocs",
	      "staff",
	      "students"
	    ]
	  }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
